# Backend Environment Variables Template (Phase 9)
# Copy this file to .env and configure your values.
# NEVER commit .env to version control.

NODE_ENV=development
PORT=5000

# Client Application URL for CORS
CLIENT_URL=http://localhost:5173

# MongoDB Connection URI (e.g. mongodb://127.0.0.1:27017/copy_trading_db)
MONGODB_URI=mongodb://127.0.0.1:27017/copy_trading_db

# JWT Configuration
# Generate secure random strings for secrets in production (e.g. openssl rand -hex 32)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars_long
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security & Cookies
COOKIE_SECRET=your_cookie_signing_secret_min_32_chars_long
SECURE_COOKIES=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=15

# Phase 3 Blockchain RPC Providers (Read-Only)
# Configure read-only public or private JSON-RPC endpoints
ETHEREUM_RPC_URL=https://cloudflare-eth.com
BASE_RPC_URL=https://mainnet.base.org
POLYGON_RPC_URL=https://polygon-rpc.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Background Monitoring Configuration
MONITORING_ENABLED=true
MONITORING_INTERVAL_MS=30000
MONITORING_MAX_CONCURRENCY=3
MONITORING_MAX_BLOCK_RANGE=50
RPC_TIMEOUT_MS=8000
RPC_MAX_RETRIES=2

# Phase 8 & 9 Testnet Execution & Emergency Controls
# Set to true to permit testnet transaction execution (defaults to false)
TESTNET_EXECUTION_ENABLED=false
# Global Emergency Kill Switch (Set to true to immediately halt all testnet execution)
EXECUTION_KILL_SWITCH=false

# Testnet RPC Endpoints (Sepolia, Base Sepolia, Polygon Amoy)
TESTNET_SEPOLIA_RPC_URL=https://rpc.sepolia.org
TESTNET_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
TESTNET_POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Server Execution Signer Wallet (Testnet Faucet Private Key - NEVER MAINNET KEY)
# Keep blank to default to MockExecutionAdapter for development/testing
TESTNET_EXECUTION_PRIVATE_KEY=
TESTNET_DEFAULT_MAX_GAS_GWEI=50
